#include <Wire.h>  
#include <LiquidCrystal_I2C.h>  
#include <math.h>  
LiquidCrystal_I2C lcd(0x27, 16, 2);  
 const int pinoUmidade = 
A0; const int pinoNTC = 
A1;  
  
void setup() {  
  Serial.begin(9600);  
   lcd.init();   
lcd.backlight();  
}  void loop() {   int leituraUmidade = 
analogRead(pinoUmidade);  
   int umidadePercentual = map(leituraUmidade, 800, 
300, 0, 100);  
   umidadePercentual = 
constrain(umidadePercentual, 0, 100);  
   int leituraNTC = 
analogRead(pinoNTC);  
   float resistencia = 10000.0 * (1023.0 / 
leituraNTC - 1.0);  
   float temperatura 
=  
    1.0 /  
    (log(resistencia / 10000.0) / 3950.0 +  
     1.0 / (25.0 + 273.15))  
    - 273.15;  
  
  Serial.print("Umidade: ");  
  Serial.print(umidadePercentual);  
  Serial.print("% | Temp: ");  
  Serial.print(temperatura);  
  Serial.println(" C");  
   lcd.clear();  
   lcd.setCursor(0, 0);   
lcd.print("Umidade:");   
lcd.print(umidadePercentual);   
lcd.print("%");  
   lcd.setCursor(0, 1);   
lcd.print("Temp:");   
lcd.print(temperatura, 1);   
lcd.print("C");  
   delay(1000);  
} 
